{
  "name": "@garage49/garage49-tui-ink",
  "version": "0.1.0",
  "description": "garage49 TUI design system for Node.js: OpenCode's look and feel as Ink components",
  "license": "MIT",
  "repository": "github:garage49/garage49-tui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "complexity": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run complexity && pnpm run test"
  },
  "peerDependencies": {
    "ink": "^8.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "string-width": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
